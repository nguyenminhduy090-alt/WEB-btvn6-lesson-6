@model IEnumerable<BookManagementMVC.Models.Book>

<h2>QUẢN LÝ SÁCH</h2>

<a asp-action="Create">Thêm sách</a>

<table border="1" cellpadding="8">
<tr>
<th>ID</th>
<th>Tên sách</th>
<th>Tác giả</th>
<th>Giá</th>
<th>Số lượng</th>
<th>Thể loại</th>
<th></th>
</tr>

@foreach(var b in Model)
{
<tr>
<td>@b.Id</td>
<td>@b.Title</td>
<td>@b.Author</td>
<td>@b.Price</td>
<td>@b.Quantity</td>
<td>@b.Category</td>
<td><a asp-action="Delete" asp-route-id="@b.Id">Xóa</a></td>
</tr>
}
</table>